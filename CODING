    <script>
        let creatorQuestions = [];
        let currentQuizData = null;
        let currentQuizCode = null;
        let playerName = "";
        let playerIndex = 0;
        let playerScore = 0;

        // Default Sample Quizzes if none exist
        const DEFAULT_QUIZZES = {
            "HEWAN": {
                title: "Kuis Hewan Lucu 🐾",
                author: "Kak Admin",
                code: "HEWAN",
                questions: [
                    { text: "Hewan apa yang suka makan wortel?", options: ["Kucing", "Kelinci", "Anjing", "Sapi"], correctIndex: 1 },
                    { text: "Suara sapi yang benar adalah...", options: ["Moo..", "Meow..", "Guk guk!", "Kwek kwek!"], correctIndex: 0 },
                    { text: "Hewan manakah yang bisa terbang di udara?", options: ["Ikan", "Burung", "Kura-kura", "Kucing"], correctIndex: 1 }
                ]
            }
        };

        function getStoredQuizzes() {
            try {
                const data = localStorage.getItem('ceria_quizzes');
                if (!data) {
                    localStorage.setItem('ceria_quizzes', JSON.stringify(DEFAULT_QUIZZES));
                    return DEFAULT_QUIZZES;
                }
                return JSON.parse(data);
            } catch(e) {
                return DEFAULT_QUIZZES;
            }
        }

        function saveStoredQuizzes(quizzes) {
            localStorage.setItem('ceria_quizzes', JSON.stringify(quizzes));
        }

        function getStoredScores() {
            try {
                const data = localStorage.getItem('ceria_scores');
                return data ? JSON.parse(data) : {};
            } catch(e) {
                return {};
            }
        }

        function saveStoredScores(scores) {
            localStorage.setItem('ceria_scores', JSON.stringify(scores));
        }

        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            const code = urlParams.get('code');
            
            if (code) {
                const quizzes = getStoredQuizzes();
                const found = quizzes[code.toUpperCase()];
                if (found) {
                    currentQuizData = found;
                    currentQuizCode = found.code;
                    document.getElementById('play-quiz-title-display').innerText = found.title;
                    document.getElementById('play-quiz-author-display').innerText = found.author || 'Teman';
                    showView('name-entry');
                    return;
                } else {
                    showAlert("Kuis Tidak Ditemukan", "Maaf, kuis dengan kode tersebut tidak ada di perangkat ini. Coba buat sendiri atau minta file kuisnya!", "🔍");
                }
            }
            showView('home');
        };

        function showView(viewName) {
      
